# Copy to .env and set unique local secrets. Blank values intentionally make Compose
# fail closed instead of launching with published default credentials. URL-encode secrets
# before embedding them in a URL for a non-Docker run.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=

# Flaw-class posture (per class). vulnerable | hardened
CLASS6_CREDIT_RACE=hardened

# Mock pricing (mock dollars per 1k tokens; chosen so per-request cost is exactly
# representable in NUMERIC(18,6) for clean attack-arithmetic during rig validation).
PRICE_PROMPT_PER_1K=0.5
PRICE_COMPLETION_PER_1K=1.5

# Deterministic mock model
SEED=1337
MOCK_MIN_TOKENS=40
MOCK_MAX_TOKENS=80
MOCK_INTER_TOKEN_DELAY_MS=5.0
