# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/metering
REDIS_URL=redis://localhost:6379/0

# Flaw-class posture (per class). vulnerable | hardened
CLASS6_CREDIT_RACE=vulnerable

# Mock pricing (mock dollars per 1k tokens; chosen so per-request cost is exactly
# representable in NUMERIC(18,6) for clean attack-arithmetic during rig validation).
PRICE_PROMPT_PER_1K=0.5
PRICE_COMPLETION_PER_1K=1.5

# Deterministic mock model
SEED=1337
MOCK_MIN_TOKENS=40
MOCK_MAX_TOKENS=80
MOCK_INTER_TOKEN_DELAY_MS=5.0
